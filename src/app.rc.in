#include <windows.h>
1 RT_MANIFEST "@CMAKE_CURRENT_BINARY_DIR@/generated/app.manifest"
101 ICON "@CMAKE_CURRENT_SOURCE_DIR@/assets/macropulse.ico"
1 VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040C04B0"
  BEGIN
   VALUE "CompanyName", "MacroPulse"
   VALUE "FileDescription", "MacroPulse - Auto-clicker et macros"
   VALUE "FileVersion", "@PROJECT_VERSION@"
   VALUE "ProductVersion", "@PROJECT_VERSION@"
   VALUE "ProductName", "MacroPulse"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x40c, 1200
 END
END
